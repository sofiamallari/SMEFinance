{
  "metadata": {
    "policy_id": "sme-finance-ai-governance",
    "version": "0.6.0",
    "status": "proposed",
    "default_effect": "deny",
    "schema_version": "1.0.0",
    "review_required": true
  },
  "roles": {
    "SME_OWNER": {
      "description": "Assigned merchant financial decision maker; not other merchants",
      "scope": "assigned_merchants"
    },
    "SME_STAFF": {
      "description": "Operational merchant user; financing denied by default",
      "scope": "assigned_merchants"
    },
    "BANK": {
      "description": "Bank reviewer of explicitly assigned financing applications",
      "scope": "assigned_financing_applications"
    },
    "SYSTEM_ADMIN": {
      "description": "Platform administration; no implicit merchant financial-data access",
      "scope": "platform_administration"
    }
  },
  "data_classifications": {
    "D0": {
      "name": "PUBLIC",
      "description": "Public financial education and published information",
      "model_disclosure": "permitted_with_source_checks"
    },
    "D1": {
      "name": "OPERATIONAL",
      "description": "Merchant operational aggregates and permitted payment trends",
      "model_disclosure": "only_after_authorization"
    },
    "D2": {
      "name": "CONFIDENTIAL",
      "description": "Merchant financial performance, cash flow, and expense information",
      "model_disclosure": "only_after_authorization_and_minimization"
    },
    "D3": {
      "name": "RESTRICTED",
      "description": "Financing applications, amounts, terms, decisions and evidence",
      "model_disclosure": "only_after_resource_and_field_authorization"
    },
    "D4": {
      "name": "SECURITY_SENSITIVE",
      "description": "Passwords, API keys, session tokens, approval secrets and private keys",
      "model_disclosure": "never"
    }
  },
  "capabilities": {
    "financial_education": {
      "description": "Explain public financial concepts and application features",
      "data_classification_ceiling": "D0",
      "role_effects": {
        "SME_OWNER": "allow",
        "SME_STAFF": "allow",
        "BANK": "allow",
        "SYSTEM_ADMIN": "allow"
      }
    },
    "sales_summary_read": {
      "description": "Read merchant sales totals and reporting summaries",
      "data_classification_ceiling": "D2",
      "role_effects": {
        "SME_OWNER": "allow",
        "SME_STAFF": "conditional",
        "BANK": "deny",
        "SYSTEM_ADMIN": "deny"
      },
      "required_application_permission": "finance.sales.summary.read"
    },
    "transaction_trends_read": {
      "description": "Read aggregated transaction volume and sales trends",
