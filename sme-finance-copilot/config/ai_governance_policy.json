    "default_effect": "deny",
    "effective_access_rule": "policy_allow_AND_existing_application_permission_AND_resource_scope_AND_field_permission",
    "server_derived_identity": true,
    "server_derived_merchant_scope": true,
    "authorize_each_tool_call": true,
    "filter_before_model": true,
    "deny_if_policy_missing_or_invalid": true,
    "deny_on_unknown_role_or_tool": true,
    "deny_indirect_disclosure": true,
    "invalidate_context_on_role_or_merchant_change": true,
    "conditional_requires_explicit_permission": true,
    "do_not_treat_data_classification_as_permission": true
  },
  "conversation_policy": {
    "mode": "session_only",
    "storage": "ephemeral_memory",
    "clear_on_refresh": true,
    "clear_on_logout": true,
    "clear_on_session_expiry": true,
    "clear_on_merchant_switch": true,
    "clear_on_new_conversation": true,
    "persist_transcripts": false,
    "persist_in_browser_storage": false,
    "log_full_transcripts": false,
    "revalidate_permissions_per_tool_call": true,
    "max_messages": 30,
    "session_idle_timeout_minutes": 30
  },
  "web_research_policy": {
    "enabled_by_default": false,
    "ask_before_every_search": true,
    "show_exact_query_terms": true,
    "show_purpose": true,
    "approval_required": "exact_query_single_use",
    "approval_ttl_seconds": 120,
    "bind_approval_to": [
      "user",
      "merchant",
      "session",
      "query_digest",
      "tool"
    ],
    "reject_query_changes": true,
    "reject_approval_replay": true,
    "private_merchant_data_in_queries": false,
    "require_source_citations": true,
    "treat_results_as_untrusted": true,
    "allow_unapproved_retry": false,
    "max_queries_per_approval": 1,
    "max_results_per_search": 5,
    "timeout_seconds": 10,
    "allowed_topics": [
      "sme_lending_rates",
      "industry_benchmarks",
      "regulations_tax"
    ]
  },
  "simulation_policy": {
    "require_explicit_user_request": true,
    "clarify_material_assumptions": true,
    "use_existing_deterministic_calculations": true,
    "non_persistent": true,
    "modify_financial_records": false,
    "use_only_authorized_inputs": true,
    "label_assumptions_and_uncertainty": true,
    "disclose_unsupported_scenarios": true,
    "compare_base_and_downside_for_material_decisions": true
  },
  "financial_response_policy": {
    "conversational_by_default": true,
    "structured_assessment_for_material_decisions": true,
    "distinguish_verified_data_from_assumptions": true,
    "do_not_confuse_revenue_with_profit": true,
    "do_not_treat_transaction_volume_as_cash": true,
    "do_not_guarantee_loan_approval": true,
    "do_not_fabricate_financial_figures": true,
    "do_not_invent_citations": true,
    "disclose_data_gaps": true
  },
  "execution_policy": {
    "mode": "read_only_and_non_persistent_simulation",
    "prohibited_actions": [
      "execute_payment",
      "submit_financing_application",
      "approve_financing_application",
      "purchase_asset",
      "modify_transaction",
      "modify_balance",
      "modify_financing_record",
      "execute_arbitrary_code",
      "arbitrary_sql",
      "unrestricted_http_request"
    ],
    "financial_write_tools_registered": false,
    "conversational_consent_is_transaction_approval": false
  },
  "security_controls": {
    "tool_allowlist_enforced": true,
    "least_privilege": true,
    "field_level_filtering": true,
    "prompt_injection_content_untrusted": true,
    "no_secrets_in_llm_context": true,
    "no_private_data_in_public_search": true,
    "provider_retention_requires_review": true,
    "audit_event_fields": [
      "timestamp",
      "user_reference",
      "role",
      "merchant_reference",
      "tool",
      "policy_version",
      "authorization_outcome",
      "approval_reference"
    ],
    "audit_full_prompt_or_response": false,
    "audit_secrets": false
  },
  "implementation_notes": [
    "This file is a proposed AI-specific upper-bound policy, not a grant of application permissions.",
    "The backend must independently check authenticated identity, merchant/resource ownership, and field-level permissions.",
    "A conditional effect is DENY unless an explicit existing application permission is verified.",
    "Tool output allowlists are illustrative; verify actual source fields and their classifications before implementation.",
    "Never send the full policy or raw sensitive data to the model as a substitute for backend enforcement."
  ]
}
