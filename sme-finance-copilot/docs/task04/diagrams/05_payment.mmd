flowchart TB
 PROP["Payment proposal"] --> CONF("Action confirmed?")
 CONF -- No --> STOP["No payment created"]
 CONF -- Yes --> P["PENDING QR Tap or Link"]
 P --> CHECK("Payment outcome?")
 CHECK -- Expire fail cancel --> ZERO["No sale"]
 CHECK -- Authorized pay --> PAID["PAID actual simulation<br/>state"]
 PAID --> SALE["Canonical positive sale<br/>and wallet state"]
 PAID --> REF("Refund valid?")
 REF -- No --> ERR["Reject refund"]
 REF -- Yes --> NEG["Linked negative record and<br/>wallet delta"]
 NEG --> LEDGER["Net sales recalculated"]

classDef decision fill:#fff4cf,stroke:#947229,color:#242424
class CONF,CHECK,REF decision
