flowchart TB
 OWNER["Owner requests RBF<br/>application"] --> C("Owner authorized?")
 C -- No --> DENY["Reject"]
 C -- Yes --> PROP["Exact amount and merchant<br/>proposal"]
 PROP --> CONF("Proposal valid?")
 CONF -- No --> STOP["No submission"]
 CONF -- Yes --> PACK["Persist submitted sandbox<br/>packet and recipient"]
 PACK --> AG("Agent authorized?")
 AG -- No --> DENY
 AG -- Yes --> REVIEW["Request information<br/>recommend or decline<br/>simulation"]
 REVIEW --> APPEND["Append review and audit"]
 APPEND --> NOTE["No real credit approval or<br/>funds"]

classDef decision fill:#fff4cf,stroke:#947229,color:#242424
class C,CONF,AG decision
