flowchart TB
 FILE["CSV XLSX files"] --> ACQ("Files valid?")
 ACQ -- No --> ERR["Validation error"]
 ACQ -- Yes --> MAP["Explicit mapping and<br/>defaults"]
 MAP --> VAL["Normalize and detect<br/>duplicates"]
 VAL --> REC("Reconciled?")
 REC -- No --> ERR
 REC -- Pass or no controls --> PRE["Exact signed preview"]
 PRE --> CONF("Preview confirmed?")
 CONF -- No --> STOP["Cancel expire or reject"]
 CONF -- Yes --> D("Ledger unchanged?")
 D -- No --> MAP
 D -- Yes --> J["Committing then journal<br/>append"]
 J --> DONE["Committed result and audit"]

classDef decision fill:#fff4cf,stroke:#947229,color:#242424
class ACQ,REC,CONF,D decision
