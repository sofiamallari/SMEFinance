# Default: authenticated. Demo must be explicitly selected and localhost only.
COPILOT_AUTH_MODE=authenticated
COPILOT_IDENTITY_DB=logs/identity.sqlite3
COPILOT_TRANSACTION_FILE=logs/manual_transactions.jsonl
COPILOT_ALLOW_COACH_ASSIGNMENT=no
# Set yes only when served behind HTTPS; enables Secure session cookies.
COPILOT_HTTPS=no
# First administrator: python -m copilot.auth bootstrap --username YOUR_NAME --email YOUR_EMAIL
# No default credentials. Password is entered at a hidden interactive prompt.
# Authentication settings and role policies are persisted in SQLite and managed in Security Controls.

HOST=127.0.0.1
PORT=8000
COPILOT_APPROVAL_SECRET=replace-with-64-hex-chars

# --- AI agent mode for the Copilot tab (any OpenAI-compatible endpoint). Blank = rule engine.
# Local .env auto-loads only LLM settings; process variables take precedence.
# Gemini verified alternative (2026-10-14): base https://generativelanguage.googleapis.com/v1beta/openai/
# COPILOT_LLM_MODEL=gemini-3.1-flash-lite (2.5-flash returned 404 for assessed key).
COPILOT_LLM_BASE_URL=
COPILOT_LLM_API_KEY=
COPILOT_LLM_MODEL=
COPILOT_AGENT_MODE=auto

# --- MCP authenticated stdio: obtain a session through /api/auth/login.
# Store the session token in a secret store, never commit it. These demo identity settings
# below are ignored unless COPILOT_AUTH_MODE=demo. API keys do not bypass authentication.
COPILOT_MCP_SESSION_TOKEN=

# --- MCP legacy demo identity (localhost demos/testing only)
COPILOT_MCP_ROLE=owner
COPILOT_MCP_MERCHANTS=
COPILOT_MCP_CONSENT=yes
COPILOT_MCP_API_KEY=
COPILOT_MCP_ALLOWED_ORIGINS=
