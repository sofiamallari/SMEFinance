{
  "mcpServers": {
    "sme-finance-copilot": {
      "type": "stdio",
      "command": "python",
      "args": [
        "-m",
        "copilot.mcp_server"
      ],
      "env": {
        "COPILOT_AUTH_MODE": "authenticated",
        "COPILOT_IDENTITY_DB": "ABSOLUTE_PATH_TO_IDENTITY_SQLITE3",
        "COPILOT_TRANSACTION_FILE": "ABSOLUTE_PATH_TO_TRANSACTION_LEDGER",
        "COPILOT_MCP_SESSION_TOKEN": "INJECT_SERVER_ISSUED_SESSION_FROM_SECRET_STORE"
      }
    }
  }
}
